# RUN & STUDY LOG · Nginx 反向代理与静态资源缓存配置
# 适用于阿里云 ECS Linux 服务器 (CentOS / Ubuntu / Alibaba Cloud Linux)

client_max_body_size 20m;

server {
    listen 80;
    server_name _; # 替换为你的实际域名或公网 IP

    # 静态前端资源根目录 (假设部署在 /var/www/running)
    root /var/www/running;
    index index.html;

    # Gzip 压缩加速
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    # 前端主入口与静态资源
    location / {
        try_files $uri $uri/ /index.html;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    # 上传照片静态直出（高性能）
    location /uploads/ {
        alias /var/www/running/server/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # API 接口反向代理至 Node.js 后端服务 (3000 端口)
    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 支持多端/多标签页 SSE 实时长连接
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        chunked_transfer_encoding off;
    }
}
